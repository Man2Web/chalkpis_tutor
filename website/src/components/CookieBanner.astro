---
/**
 * A cookie notice (the user's choice on 6 Nov 2026): tracking runs from the first visit, and "Got it" only hides the
 * notice for good in this browser. Turning tracking off is on /cookies.
 */
---
<div class="consent panel" id="consent" role="region" aria-label="Cookies" hidden>
  <p class="small">
    This site uses cookies. <a href="/cookies">Cookie policy</a>
  </p>
  <div class="consent-actions">
    <button type="button" class="btn btn-sm btn-dark" data-got-it>Got it</button>
  </div>
</div>

<script is:inline>
  (function () {
    var box = document.getElementById('consent');
    // shown until "Got it" (or an earlier Accept / Reject) is saved
    if (!window.cpConsentChoice || !window.cpConsentChoice()) box.hidden = false;
    box.querySelector('[data-got-it]').addEventListener('click', function () {
      window.cpConsent('granted');
      box.hidden = true;
    });
  })();
</script>

<style>
  .consent {
    position: fixed; z-index: 50; left: 24px; bottom: 24px; width: min(400px, calc(100% - 32px));
    padding: 20px; box-shadow: 0 0 0 1px rgba(17, 17, 17, 0.06), 0 12px 32px rgba(17, 17, 17, 0.12);
  }
  .consent[hidden] { display: none; }
  .consent p { margin: 0; color: var(--ink); }
  .consent a { color: var(--blue); }
  .consent-actions { margin-top: 16px; display: flex; justify-content: flex-end; }
  @media (max-width: 640px) {
    .consent { left: 16px; bottom: 16px; }
    .consent-actions .btn { flex: 1; }
  }
</style>
