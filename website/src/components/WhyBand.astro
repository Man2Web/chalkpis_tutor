---
/** "Why tutors switch": a dark band of tilted white cards with the outcome figures the owner supplied (6 Nov 2026). */
import Icon from './Icon.astro';

interface Props {
  title?: string;
}
const { title = 'Why tutors choose ChalkPis Tutor' } = Astro.props;
const WHY = [
  { num: '30%', label: 'Time Saved', icon: 'clock', tilt: -3 },
  { num: '40%', label: 'Productivity Increase', icon: 'trend', tilt: 2 },
  { num: '25%', label: 'Cost reduction', icon: 'wallet', tilt: -1.5 },
  { num: '16x', label: 'Faster Fee Collection', icon: 'bolt', tilt: 3 },
] as const;
---
<section class="why-band" aria-labelledby="why-h">
  <div class="wrap">
    <h2 class="h2" id="why-h">{title}</h2>
    <div class="why-cards">
      {WHY.map((w) => (
        <div class="why-card" style={`--tilt: ${w.tilt}deg`}>
          <p class="num why-num">{w.num}</p>
          <p class="why-label">{w.label}</p>
          <span class="tile why-icon" aria-hidden="true"><Icon name={w.icon} size={26} /></span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .why-band { margin-top: 96px; padding: 96px 0 104px; background: linear-gradient(120deg, #0b1620 0%, #0b2a44 55%, #0d5d93 100%); }
  .why-band .h2 { text-align: center; color: #fff; }
  .why-cards { margin-top: 48px; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; }
  .why-card { background: #fff; border-radius: 28px; padding: 28px 24px; min-height: 240px; display: flex; flex-direction: column; transform: rotate(var(--tilt)); transition: transform 0.25s ease; box-shadow: 0 24px 48px -24px rgba(0, 0, 0, 0.5); }
  .why-card:hover { transform: rotate(0deg) translateY(-4px); }
  .why-num { font-size: 40px; line-height: 1; }
  .why-label { margin-top: 10px; font-size: 16px; line-height: 1.4; color: var(--text); }
  .why-icon { margin-top: auto; align-self: flex-end; width: 56px; height: 56px; border-radius: 16px; }
  @media (prefers-reduced-motion: reduce) { .why-card, .why-card:hover { transition: none; } }
  @media (max-width: 1000px) { .why-cards { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) {
    .why-band { margin-top: 64px; padding: 64px 0 72px; }
    .why-cards { gap: 12px; }
    .why-card { transform: none; min-height: 0; padding: 20px 18px; border-radius: 20px; }
    .why-num { font-size: 30px; }
    .why-label { font-size: 14px; }
    .why-icon { display: none; }
  }
</style>
