---
/**
 * The ChalkPis Tutor logo: the ChalkPis C mark followed by "tutor". "tutor" is drawn from the strokes of the
 * chalkpis wordmark (server/public/logo.svg), so no font is involved. Use word="#FFFFFF" on dark backgrounds.
 */
interface Props {
  height?: number;
  mark?: string;
  word?: string;
  class?: string;
}
const { height = 36, mark = '#0E77BE', word = '#111111', class: className } = Astro.props;
const width = Math.round((height * 2942) / 1001);
