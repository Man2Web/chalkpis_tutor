---
/**
 * The Tutor logo, drawn from the brand kit's own file (brand/tutor-logo-color.svg) so the letters are never retyped.
 * The kit's colour versions are the same paths in other colours:
 *   color          blue mark, ink letters: white and light backgrounds (the main version)
 *   color-on-dark  blue mark, #F5F5F5 letters: black and navy backgrounds
 *   white          all white: brand blue, photos, strong colours
 *   chalk          all chalk #F4F1EA: the blackboard navy
 * Smallest on screen: 24 px tall.
 */
import source from '../../brand/tutor-logo-color.svg?raw';

type Variant = 'color' | 'color-on-dark' | 'white' | 'chalk';
interface Props {
  height?: number;
  variant?: Variant;
  class?: string;
}
const { height = 36, variant = 'color', class: className } = Astro.props;

const COLOURS: Record<Variant, { mark: string; word: string }> = {
  color: { mark: '#0E77BE', word: '#111111' },
  'color-on-dark': { mark: '#0E77BE', word: '#F5F5F5' },
  white: { mark: '#FFFFFF', word: '#FFFFFF' },
  chalk: { mark: '#F4F1EA', word: '#F4F1EA' },
};
const [, vw, vh] = source.match(/viewBox="0 0 ([\d.]+) ([\d.]+)"/)!;
const { mark, word } = COLOURS[variant];
const paths = (source.match(/<path[^>]*\/>/g) ?? [])
  .map((p) => p.replace('fill="#0E77BE"', `fill="${mark}"`).replace('fill="#111111"', `fill="${word}"`))
  .join('');
const width = Math.round((height * Number(vw)) / Number(vh));
---
<svg role="img" aria-label="ChalkPis Tutor" viewBox={`0 0 ${vw} ${vh}`} width={width} height={height} class={className} set:html={paths} />
