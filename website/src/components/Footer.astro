---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import {
  APP_STORE_URL, PLAY_STORE_URL, START_URL, SIGN_IN_URL, TERMS_URL, PRIVACY_URL, DELETE_ACCOUNT_URL,
  WHATSAPP_URL, SUPPORT_EMAIL, COMPANY, SCHOOL_ERP_URL,
} from '../config';

// Only pages that exist today are linked; the class-type, about and contact pages get added here when they are built.
const cols = [
  { title: 'Product', links: [
    { label: 'Features', href: '/#features' },
    { label: 'Who it’s for', href: '/#roles' },
    { label: 'Pricing', href: '/pricing' },
    { label: 'Questions', href: '/pricing#faq' },
  ] },
  { title: 'Get started', links: [
    { label: 'Start free trial', href: START_URL },
    { label: 'Sign in', href: SIGN_IN_URL },
    { label: 'Chat on WhatsApp', href: WHATSAPP_URL },
    { label: SUPPORT_EMAIL, href: `mailto:${SUPPORT_EMAIL}` },
  ] },
  { title: 'Legal', links: [
    { label: 'Terms and Conditions', href: TERMS_URL },
    { label: 'Privacy Policy', href: PRIVACY_URL },
    { label: 'Cookie policy', href: '/cookies' },
    { label: 'Delete your account', href: DELETE_ACCOUNT_URL },
  ] },
];
---
<footer class="foot">
  <div class="wrap foot-top">
    <div class="foot-brand">
      <a href="/" aria-label="ChalkPis Tutor home"><Logo height={34} /></a>
      <p class="small" style="margin-top: 16px; line-height: 1.6">Attendance, fees and WhatsApp updates for tuition centres, coaching classes and academies across India.</p>
      <div class="foot-contact">
        <a href={WHATSAPP_URL}><Icon name="whatsapp" size={16} />Chat on WhatsApp</a>
        <a href={`mailto:${SUPPORT_EMAIL}`}><Icon name="mail" size={16} />{SUPPORT_EMAIL}</a>
      </div>
      <div class="badges">
        <a href={APP_STORE_URL}><img src="/badges/app-store.svg" alt="Download on the App Store" width="120" height="40" style="height: 40px; width: auto" /></a>
        <a href={PLAY_STORE_URL} class="play"><img src="/badges/google-play.png" alt="Get it on Google Play" width="155" height="60" style="height: 60px; width: auto" /></a>
      </div>
    </div>
    <div class="foot-cols">
      {cols.map((c) => (
        <nav aria-label={c.title}>
          <h2 class="foot-h">{c.title}</h2>
          <ul>{c.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
        </nav>
      ))}
    </div>
  </div>
  <div class="foot-bottom">
    <div class="wrap foot-bottom-in">
      <span>© {new Date().getFullYear()} {COMPANY}</span>
      <span>From the makers of <a href={SCHOOL_ERP_URL} class="erp">ChalkPis School ERP</a></span>
    </div>
  </div>
</footer>

<style>
  .foot-top { padding-top: 64px; padding-bottom: 48px; display: flex; flex-wrap: wrap; gap: 48px; }
  .foot-brand { flex: 1 1 280px; min-width: 0; max-width: 360px; }
  .foot-contact { margin-top: 20px; display: flex; flex-direction: column; gap: 10px; font-size: 14px; font-weight: 500; }
  .foot-contact a { display: inline-flex; align-items: center; gap: 8px; }
  .badges { margin-top: 24px; display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
  /* the Google Play badge file carries its own clear space */
  .badges .play { margin: -10px; }
  .foot-cols { flex: 2 1 480px; min-width: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 32px 24px; }
  .foot-h { margin: 0 0 16px; font-size: 14px; font-weight: 600; color: var(--ink); }
  .foot-cols ul { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 12px; font-size: 14px; }
  .foot-bottom { border-top: 1px solid rgba(11, 11, 15, 0.06); }
  .foot-bottom-in { padding-top: 20px; padding-bottom: 20px; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 10px; font-size: 13px; color: var(--muted); }
  .erp { font-weight: 600; color: var(--ink) !important; }
</style>
