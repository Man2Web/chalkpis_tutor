---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import {
  APP_STORE_URL, PLAY_STORE_URL, WHATSAPP_URL, SUPPORT_EMAIL, COMPANY, SCHOOL_ERP_URL, TERMS_URL, PRIVACY_URL,
} from '../config';

import { CLASSES, classUrl } from '../data/classes';
import { GUIDES } from '../data/guides';

const cols = [
  { title: 'Product', links: [
    { label: 'Fee collection', href: '/fee-collection' },
    { label: 'Features', href: '/features' },
    { label: 'Who it’s for', href: '/#roles' },
    { label: 'Pricing', href: '/pricing' },
    { label: 'Questions', href: '/pricing#faq' },
  ] },
  { title: 'Classes', links: CLASSES.map((c) => ({ label: c.short, href: classUrl(c) })) },
  { title: 'Free guides', links: [
    ...GUIDES.map((g) => ({ label: g.short, href: `/guides/${g.slug}` })),
    { label: 'All guides', href: '/guides' },
  ] },
];
---
<footer class="foot">
  <div class="wrap foot-top">
    <div class="foot-brand">
      <a href="/" aria-label="ChalkPis Tutor home"><Logo height={34} /></a>
      <p class="tagline foot-tag">Manage • Teach • Grow</p>
      <p class="small foot-about">Fee collection, attendance and WhatsApp updates for classes and academies across India.</p>
      <div class="badges">
        <a href={APP_STORE_URL}><img src="/badges/app-store.svg" alt="Download on the App Store" width="120" height="40" style="height: 40px; width: auto" /></a>
        <a href={PLAY_STORE_URL} class="play"><img src="/badges/google-play.png" alt="Get it on Google Play" width="155" height="60" style="height: 60px; width: auto" /></a>
      </div>
    </div>
    {cols.map((c) => (
      <nav aria-label={c.title} class="foot-col">
        <h2 class="foot-h">{c.title}</h2>
        <ul>{c.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </nav>
    ))}
    <div class="foot-col foot-contact">
      <h2 class="foot-h">Company</h2>
      <ul>
        <li><a href="/about">About us</a></li>
        <li><a href="/contact">Contact</a></li>
        <li><a href={WHATSAPP_URL} class="with-icon"><Icon name="whatsapp" size={16} />Chat on WhatsApp</a></li>
        <li><a href={`mailto:${SUPPORT_EMAIL}`} class="with-icon"><Icon name="mail" size={16} />{SUPPORT_EMAIL}</a></li>
      </ul>
    </div>
  </div>
  <div class="foot-bottom">
    <div class="wrap foot-bottom-in">
      <span>© {new Date().getFullYear()} {COMPANY}</span>
      <nav aria-label="Legal" class="legal"><a href={TERMS_URL}>Terms</a><a href={PRIVACY_URL}>Privacy</a><a href="/cookies">Cookies</a></nav>
      <span>From the makers of <a href={SCHOOL_ERP_URL} class="erp">ChalkPis School ERP</a></span>
    </div>
  </div>
</footer>

<style>
  /* brand on the left, then the link columns, spread across the full width */
  .foot-top { padding-top: 64px; padding-bottom: 56px; display: grid; grid-template-columns: minmax(0, 1.4fr) repeat(4, minmax(0, 1fr)); gap: 40px; }
  @media (max-width: 1000px) {
    .foot-top { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 40px 28px; }
    .foot-brand { grid-column: 1 / -1; }
  }
  .foot-tag { margin-top: 14px; color: var(--blue-ink); }
  .foot-about { margin-top: 12px; max-width: 340px; line-height: 1.6; }
  .badges { margin-top: 24px; display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
  /* the Google Play badge file carries its own clear space */
  .badges .play { margin: -10px; }
  .foot-col { padding-top: 6px; }
  .foot-h { margin: 0 0 16px; font-size: 14px; font-weight: 600; color: var(--ink); }
  .foot-col ul { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 12px; font-size: 14px; }
  .with-icon { display: inline-flex; align-items: center; gap: 8px; }
  @media (max-width: 760px) {
    /* two link columns side by side; Contact gets a full row so the email address fits */
    .foot-top { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 40px 24px; padding-top: 48px; }
    .foot-brand, .foot-contact { grid-column: 1 / -1; }
  }
  .foot-bottom { border-top: 1px solid rgba(17, 17, 17, 0.06); }
  .foot-bottom-in { padding-top: 20px; padding-bottom: 20px; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 10px; font-size: 13px; color: var(--muted); }
  .erp { font-weight: 600; color: var(--ink) !important; }
  .legal { display: flex; gap: 16px; }
</style>
