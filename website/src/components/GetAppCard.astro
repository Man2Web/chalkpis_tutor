---
/** "Get the app" QR card, fixed in the bottom-right corner on wide screens. It can be closed for the visit. */
import AppQR from './AppQR.astro';
---
<aside class="get-app panel" id="get-app" aria-label="Get the app" hidden>
  <button type="button" class="get-app-close" aria-label="Close">×</button>
  <p class="get-app-title">Get the app</p>
  <AppQR size={96} from="corner" />
  <p class="get-app-note">Scan with your phone camera</p>
</aside>

<script is:inline>
  (function () {
    var card = document.getElementById('get-app');
    var closed = false;
    try { closed = sessionStorage.getItem('cp_get_app_closed') === '1'; } catch (e) {}
    if (!closed) card.hidden = false;
    card.querySelector('.get-app-close').addEventListener('click', function () {
      card.hidden = true;
      try { sessionStorage.setItem('cp_get_app_closed', '1'); } catch (e) {}
    });
  })();
</script>

<style>
  .get-app { position: fixed; z-index: 30; right: 24px; bottom: 24px; width: 136px; padding: 14px 14px 12px; display: none; flex-direction: column; align-items: center; gap: 8px; text-align: center; box-shadow: 0 0 0 1px rgba(11, 11, 15, 0.06), 0 12px 32px rgba(11, 11, 15, 0.14); }
  .get-app-title { font-size: 13px; font-weight: 600; }
  .get-app-note { font-size: 11px; line-height: 1.3; color: var(--muted); }
  .get-app-close { position: absolute; top: 2px; right: 4px; width: 28px; height: 28px; border: 0; background: transparent; font-size: 18px; line-height: 1; color: var(--faint); cursor: pointer; border-radius: 8px; }
  .get-app-close:hover { color: var(--ink); background: var(--line); }
  /* only where a phone is not what you are holding */
  @media (min-width: 1100px) and (hover: hover) { .get-app:not([hidden]) { display: flex; } }
</style>
