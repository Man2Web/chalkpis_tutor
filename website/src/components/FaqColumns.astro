---
/** Questions in two columns: the heading (and an optional note in the slot) on the left, the answers on the right. */
import Icon from './Icon.astro';

interface Props {
  title: string;
  items: readonly { q: string; a: string }[];
}
const { title, items } = Astro.props;
---
<div class="faq-2">
  <div class="faq-side">
    <h2 class="h2">{title}</h2>
    <slot />
  </div>
  <div class="faq">
    {items.map((f, i) => (
      <details open={i === 0}>
        <summary><span>{f.q}</span><Icon name="plus" size={20} class="faq-icon" /></summary>
        <p>{f.a}</p>
      </details>
    ))}
  </div>
</div>

<style>
  .faq-2 { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr); gap: 56px; align-items: start; }
  .faq-side { position: sticky; top: 112px; }
  .faq-side :global(a) { font-weight: 600; color: var(--blue-ink); text-decoration: none; }
  .faq-side :global(a:hover) { text-decoration: underline; }
  .faq { border-top: 1px solid var(--border); }
  .faq details { border-bottom: 1px solid var(--border); }
  .faq summary { list-style: none; cursor: pointer; min-height: 44px; padding: 22px 0; display: flex; align-items: center; gap: 16px; font-size: 17px; font-weight: 600; line-height: 1.4; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary span { flex: 1; }
  .faq summary:hover span { color: var(--blue-ink); }
  .faq :global(.faq-icon) { flex: none; transition: transform 0.2s ease; }
  .faq details[open] :global(.faq-icon) { transform: rotate(45deg); }
  .faq details p { padding: 0 40px 22px 0; font-size: 15px; line-height: 1.65; color: var(--text); }
  @media (max-width: 860px) {
    .faq-2 { grid-template-columns: minmax(0, 1fr); gap: 28px; }
    .faq-side { position: static; }
  }
  @media (max-width: 600px) { .faq details p { padding-right: 0; } }
</style>
