---
/**
 * A QR code (drawn at build time, no script) for chalkpistutor.com/get-app, which sends each phone to its own store.
 * The campaign tag says where on the site it was scanned.
 */
import QRCode from 'qrcode';
import { SITE_URL } from '../config';

interface Props {
  size?: number;
  from: string;
}
const { size = 112, from } = Astro.props;
const url = `${SITE_URL}/get-app?utm_source=website&utm_medium=qr&utm_campaign=${encodeURIComponent(from)}`;
const svg = await QRCode.toString(url, { type: 'svg', margin: 0, errorCorrectionLevel: 'M', color: { dark: '#111111', light: '#ffffff' } });
---
<span class="qr" style={`width: ${size}px; height: ${size}px`} role="img" aria-label="QR code to get the ChalkPis Tutor app" set:html={svg} />

<style>
  .qr { display: block; flex: none; }
  .qr :global(svg) { width: 100%; height: 100%; display: block; }
</style>
