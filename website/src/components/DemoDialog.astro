---
/**
 * "Book a demo": a short form that opens WhatsApp with the request written out, sent from the visitor's own WhatsApp
 * to the support number. No server involved. Any element with data-demo opens it. Counts as generate_lead / Lead.
 */
import { SUPPORT_WHATSAPP } from '../config';
import { CLASSES } from '../data/classes';
---
<dialog class="demo" id="demo" aria-labelledby="demo-title">
  <form method="dialog" class="demo-form" data-wa={SUPPORT_WHATSAPP}>
    <div class="demo-head">
      <h2 class="h3" id="demo-title">Book a free demo</h2>
      <button type="submit" value="close" formnovalidate class="demo-x" aria-label="Close">×</button>
    </div>
    <p class="small" style="margin-top: 6px">Tell us a little about your class. This opens WhatsApp with your request written out; send it and we’ll set up a time to show you the app.</p>
    <label for="demo-name">Your name</label>
    <input id="demo-name" name="name" autocomplete="name" required maxlength="60" />
    <label for="demo-centre">Name of your class or centre</label>
    <input id="demo-centre" name="centre" maxlength="100" />
    <label for="demo-kind">What do you teach?</label>
    <select id="demo-kind" name="kind">
      {CLASSES.map((c) => <option>{c.short}</option>)}
      <option>Something else</option>
    </select>
    <label for="demo-city">City or town</label>
    <input id="demo-city" name="city" autocomplete="address-level2" maxlength="60" />
    <button type="submit" value="send" class="btn btn-dark demo-send">Send on WhatsApp</button>
  </form>
</dialog>

<script is:inline>
  (function () {
    var dlg = document.getElementById('demo');
    var form = dlg.querySelector('form');
    document.addEventListener('click', function (e) {
      var t = e.target.closest && e.target.closest('[data-demo]');
      if (!t) return;
      e.preventDefault();
      dlg.showModal();
      dlg.querySelector('#demo-name').focus();
    });
    dlg.addEventListener('click', function (e) { if (e.target === dlg) dlg.close(); });
    form.addEventListener('submit', function (e) {
      if (e.submitter && e.submitter.value === 'close') return;
      var f = new FormData(form);
      var lines = ['Hi, I would like a demo of ChalkPis Tutor.', 'Name: ' + f.get('name')];
      if (f.get('centre')) lines.push('Centre: ' + f.get('centre'));
      lines.push('I teach: ' + f.get('kind'));
      if (f.get('city')) lines.push('City: ' + f.get('city'));
      if (window.cpTrack) window.cpTrack('generate_lead', { kind: String(f.get('kind')) }, 'Lead', true);
      window.open('https://wa.me/' + form.dataset.wa + '?text=' + encodeURIComponent(lines.join('\n')), '_blank', 'noopener');
      form.reset();
    });
  })();
</script>

<style>
  .demo { width: min(440px, calc(100% - 32px)); border: 0; border-radius: 20px; padding: 28px; color: var(--ink); box-shadow: 0 24px 64px rgba(17, 17, 17, 0.3); }
  .demo::backdrop { background: rgba(17, 17, 17, 0.45); }
  .demo-form { display: flex; flex-direction: column; }
  .demo-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .demo-x { width: 36px; height: 36px; border: 0; border-radius: 10px; background: var(--line); font-size: 20px; line-height: 1; cursor: pointer; }
  .demo label { margin-top: 16px; font-size: 14px; font-weight: 600; }
  .demo input, .demo select { margin-top: 6px; height: 46px; padding: 0 14px; border: 1px solid rgba(0, 0, 0, 0.16); border-radius: 12px; font: inherit; font-size: 15px; background: #fff; color: var(--ink); }
  .demo input:focus, .demo select:focus { outline: 2px solid var(--blue); outline-offset: 0; border-color: transparent; }
  .demo-send { margin-top: 24px; width: 100%; }
</style>
