    <h1 class="h1">This page isn't here</h1>
    <p class="lead" style="margin-top: 16px">It may have moved. Start from the home page or see our plans.</p>
    <div style="margin-top: 28px; display: flex; flex-wrap: wrap; gap: 12px; justify-content: center">
      <a class="btn btn-dark" href="/">Go to the home page</a>
      <a class="btn btn-soft" href="/pricing">See pricing</a>
    </div>
  </section>
</Base>
