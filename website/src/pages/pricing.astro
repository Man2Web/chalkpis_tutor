---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { START_URL, WHATSAPP_URL, SUPPORT_EMAIL } from '../config';
import { PLANS, FEATURE_GROUPS, FAQS, rupees } from '../data/plans';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQS.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<Base
  title="Pricing · ChalkPis Tutor"
  description="ChalkPis Tutor plans from ₹199 a month. Every feature and WhatsApp messages included in every plan. Try free for 7 days."
  schema={schema}
>
  <section class="wrap top">
    <h1 class="h1" style="max-width: 820px; margin: 0 auto">Pick a plan by how many students you teach</h1>
    <p class="lead" style="margin: 22px auto 0; max-width: 560px">Try everything free for 7 days. Every feature is in every plan, so you only choose a size.</p>
    <div class="switch" role="group" aria-label="Billing period" data-cycle>
      <button type="button" aria-pressed="true" data-value="month">Monthly</button>
      <button type="button" aria-pressed="false" data-value="year">Yearly <span class="save">2 months free</span></button>
    </div>
  </section>

  <section class="wrap" style="padding-top: 40px">
    <div class="plans" data-plans data-cycle-value="month">
      {PLANS.map((p) => (
        <div class={`card plan ${p.popular ? 'plan-dark' : ''}`}>
          <div class="plan-head">
            <h2 class="plan-name">{p.name}</h2>
            {p.popular && <span class="pill plan-badge">Most popular</span>}
          </div>
          <p class="plan-price">
            <span class="num price">
              <span class="m">{rupees(p.month)}</span><span class="y">{rupees(p.year)}</span>
            </span>
            <span class="per"><span class="m">/ month</span><span class="y">/ year</span></span>
          </p>
          <p class="note"><span class="m">or {rupees(p.year)} a year</span><span class="y">Works out to {rupees(Math.round(p.year / 12))} a month</span></p>
          <ul class="ticks">
            <li><Icon name="check" size={18} stroke={2.4} />{p.students}</li>
            <li><Icon name="check" size={18} stroke={2.4} />{p.batches}</li>
            <li><Icon name="check" size={18} stroke={2.4} />WhatsApp messages included</li>
          </ul>
          <a class={`btn ${p.popular ? 'btn-light' : 'btn-dark'} plan-cta`} href={START_URL}>Start 7-day free trial</a>
        </div>
      ))}
    </div>
    <p class="small" style="margin-top: 22px; text-align: center">Your plan starts when the free week ends, so you never lose a trial day.</p>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="head"><h2 class="h2">Every plan has all of this</h2></div>
      <div class="groups">
        {FEATURE_GROUPS.map((g) => (
          <div class="card group">
            <h3 class="h4">{g.title}</h3>
            <ul>{g.items.map((it) => <li><Icon name="check" size={16} stroke={2.4} />{it}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="faq" class="sec">
    <div class="wrap" style="max-width: 868px">
      <div class="head"><h2 class="h2">Questions teachers ask</h2></div>
      <div class="faq">
        {FAQS.map((f, i) => (
          <details open={i === 0}>
            <summary><span>{f.q}</span><Icon name="plus" size={20} class="faq-icon" /></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
      <p class="small" style="margin-top: 28px; text-align: center; font-size: 15px">Something else? <a href={WHATSAPP_URL} class="link-blue">Ask us on WhatsApp</a> or write to <a href={`mailto:${SUPPORT_EMAIL}`} class="link-blue">{SUPPORT_EMAIL}</a>.</p>
    </div>
  </section>

  <section class="sec end">
    <div class="wrap">
      <div class="card banner">
        <h2 class="h2" style="flex: 1 1 420px; max-width: 640px">Try it with your own batches this week</h2>
        <a class="btn btn-dark" href={START_URL}>Start 7-day free trial</a>
      </div>
    </div>
  </section>
</Base>

<script>
  // Monthly / Yearly switch: flips a data attribute; CSS shows the matching prices.
  const group = document.querySelector<HTMLElement>('[data-cycle]');
  const plans = document.querySelector<HTMLElement>('[data-plans]');
  group?.querySelectorAll<HTMLButtonElement>('button').forEach((b) => {
    b.addEventListener('click', () => {
      group.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', x === b ? 'true' : 'false'));
      if (plans) plans.dataset.cycleValue = b.dataset.value;
    });
  });
</script>

<style>
  .top { padding-top: 72px; text-align: center; }
  .switch { margin: 36px auto 0; display: inline-flex; align-items: center; gap: 4px; background: #f1f2f4; border-radius: 14px; padding: 4px; }
  .switch button { border: 0; cursor: pointer; background: transparent; border-radius: 11px; padding: 0 18px; height: 44px; font-size: 15px; font-weight: 600; color: var(--ink); display: inline-flex; align-items: center; gap: 8px; }
  .switch button[aria-pressed='true'] { background: #fff; box-shadow: 0 1px 3px rgba(11, 11, 15, 0.12); }
  .save { background: var(--yellow); border-radius: 999px; padding: 3px 8px; font-size: 12px; font-weight: 600; }

  .plans { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 20px; }
  .plan { display: flex; flex-direction: column; }
  .plan-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 26px; }
  .plan-name { font-size: 20px; font-weight: 600; }
  .plan-badge { background: var(--blue); color: #fff; }
  .plan-price { margin-top: 24px; display: flex; align-items: baseline; gap: 6px; }
  .price { font-size: 52px; line-height: 1; }
  .per, .note { color: var(--muted); }
  .per { font-size: 15px; }
  .note { margin-top: 8px; font-size: 14px; min-height: 20px; }
  .ticks { list-style: none; padding: 0; margin-top: 28px; display: flex; flex-direction: column; gap: 12px; font-size: 15px; }
  .ticks li { display: flex; gap: 10px; align-items: center; color: var(--ink); }
  .ticks svg { color: var(--blue); }
  .plan-cta { margin-top: 32px; }
  .plan-dark { background: var(--ink); color: #fff; }
  .plan-dark .per, .plan-dark .note { color: #d4d4d8; }
  .plan-dark .ticks li { color: #fff; }
  .plan-dark .ticks svg { color: #7dd3fc; }
  [data-cycle-value='month'] .y, [data-cycle-value='year'] .m { display: none; }

  .groups { margin-top: 44px; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); gap: 16px; }
  .group { padding: 26px; }
  .group ul { list-style: none; padding: 0; margin-top: 16px; display: flex; flex-direction: column; gap: 10px; font-size: 14px; line-height: 1.45; color: var(--text); }
  .group li { display: flex; gap: 10px; align-items: flex-start; }
  .group svg { flex: none; margin-top: 2px; color: var(--blue); }

  .faq { margin-top: 40px; border-top: 1px solid #e4e4e7; }
  .faq details { border-bottom: 1px solid #e4e4e7; }
  .faq summary { list-style: none; cursor: pointer; min-height: 44px; padding: 22px 0; display: flex; align-items: center; gap: 16px; font-size: 17px; font-weight: 600; line-height: 1.4; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary span { flex: 1; }
  .faq summary:hover span { color: var(--blue-ink); }
  .faq :global(.faq-icon) { flex: none; transition: transform 0.2s ease; }
  .faq details[open] :global(.faq-icon) { transform: rotate(45deg); }
  .faq details p { padding: 0 40px 22px 0; font-size: 15px; line-height: 1.65; color: var(--text); }
  .link-blue { font-weight: 600; color: var(--blue-ink); text-decoration: none; }
  .link-blue:hover { text-decoration: underline; }

  .banner { background: var(--blue-50); padding: 48px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 24px; }

  @media (max-width: 600px) {
    .top { padding-top: 40px; text-align: left; }
    .top .lead { margin-left: 0 !important; }
    .switch { margin-left: 0; }
    .banner { padding: 24px; }
    .banner .btn { width: 100%; }
    .faq details p { padding-right: 0; }
  }
</style>
