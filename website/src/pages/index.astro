---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Logo from '../components/Logo.astro';
import PlanCards from '../components/PlanCards.astro';
import WhyBand from '../components/WhyBand.astro';
import QaRow from '../components/QaRow.astro';
import FaqColumns from '../components/FaqColumns.astro';
import CtaBand from '../components/CtaBand.astro';
import { START_URL, SITE_URL, SITE_NAME, PLAY_STORE_URL, APP_STORE_URL, TRIAL_DAYS } from '../config';
import { PLANS } from '../data/plans';

const MORE = [
  { id: 'tests', icon: 'tests', title: 'Tests and report cards', desc: 'Marks for a whole batch on one screen, with ranks and grades.' },
  { id: 'parts', icon: 'wallet', title: 'Yearly fees in parts', desc: 'Split a year’s fee into up to four parts, each with its own reminder.' },
  { id: 'enquiries', icon: 'enquiry', title: 'Enquiries to admissions', desc: 'Every walk-in and call, from first question to joined.' },
  { id: 'timetable', icon: 'cal', title: 'Timetable and calendar', desc: 'Your week at a glance, with clashes flagged early.' },
  { id: 'posters', icon: 'poster', title: 'Poster maker', desc: 'Toppers, champions and admissions posters for your WhatsApp status.' },
] as const;

// Day-to-day questions, checked against the server code (worker.ts DAILY_LIMIT) and the WhatsApp templates.
const HOME_FAQS = [
  { q: 'Do receipts go out by themselves?', a: 'Yes. When you record a payment, the parent gets a receipt on WhatsApp with the receipt number and any balance still due.' },
  { q: 'Can a yearly fee be paid in parts?', a: 'Yes. Split it into up to four parts. Each part has its own due date and reminder, and the receipt shows what is left.' },
  { q: 'How many WhatsApp messages can I send?', a: 'Up to 150 a day during the free trial and 3,000 a day on any plan. Absent alerts, reminders and receipts all count, and none of them cost extra.' },
  { q: 'Does it work on an iPhone and on my laptop?', a: 'Yes. There are apps for Android and iPhone, and on a laptop the browser version opens with a full desktop layout. Sign in with the same WhatsApp number everywhere.' },
  { q: 'Can I bring in my existing student list?', a: 'Yes. Import it from Excel, or add students straight from your phone contacts.' },
];


// Cities where tutors use ChalkPis Tutor today. Repeated 4 times so the short list fills the row and loops without a gap.
const CITIES = ['Mumbai', 'Mysore', 'Kochi', 'Chennai'];
const cityLoop = [0, 1, 2, 3].flatMap((n) => CITIES.map((name) => ({ name, copy: n > 0 })));

const ROLES = [
  { id: 'owner', title: 'Owners and teachers', desc: 'Students, batches, attendance, fees, reports and parents, all in one place.', steps: [
    { icon: 'page', title: 'Add your batches and students', sub: 'One by one, or import the list from Excel' },
    { icon: 'rupee', title: 'Set each student’s fee', sub: 'Monthly, or a yearly fee in parts' },
    { icon: 'qr', title: 'Add your UPI ID', sub: 'Your QR goes on every fee reminder' },
    { icon: 'bell', title: 'Turn on automatic messages', sub: 'Alerts and reminders go out on their own' },
    { icon: 'check', title: 'See who has paid this month', sub: 'Collected and pending, at a glance' },
  ] },
  { id: 'helper', title: 'Staff', desc: 'Take attendance for their own batches. They never see fees or phone numbers.', steps: [
    { icon: 'chat', title: 'Invited to your centre', sub: 'The invite arrives on WhatsApp' },
    { icon: 'user', title: 'Signs in with WhatsApp', sub: 'A 6-digit code, no password' },
    { icon: 'cal', title: 'Sees only their batches', sub: 'Kids Bharatanatyam · Juniors' },
    { icon: 'check', title: 'Attendance marked', sub: 'The owner sees it at once' },
  ] },
  { id: 'parent', title: 'Parents', desc: 'Updates on WhatsApp and a private page for their child. Nothing to install.', steps: [
    { icon: 'chat', title: 'Welcome: Aarohi is enrolled', sub: 'Nritya Dance Academy' },
    { icon: 'bell', title: 'Updates on WhatsApp', sub: 'Absences, fee reminders and receipts' },
    { icon: 'page', title: 'A private page for their child', sub: 'Attendance, fees, results, homework' },
    { icon: 'user', title: 'One link for brothers and sisters', sub: 'Every child on the same page' },
  ] },
] as const;

// Real tutor feedback only. Text is quoted from what the tutor wrote; cuts are marked with "…" and the brand spelling
// is corrected to ChalkPis. With fewer than three quotes the section shows them as featured cards; from three up it
// becomes a scrolling row.
const QUOTES = [
  {
    title: 'Managing my institute has never felt this easy!',
    text: 'I had tried a few other applications before discovering ChalkPis, but I found them complicated, especially when handling student admissions and management. ChalkPis has been a completely different experience! … One feature I particularly love is the ability to add students directly from my phone contacts. It makes the admission process much faster and more convenient, saving me valuable time.',
    who: 'Coaching institute owner',
    where: 'Mysore, Karnataka',
  },
];
const scrollQuotes = QUOTES.length >= 3;
const quoteLoop = [...QUOTES.map((q) => ({ ...q, copy: false })), ...QUOTES.map((q) => ({ ...q, copy: true }))];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: SITE_NAME,
  url: SITE_URL,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Android, iOS, Web',
  description: 'Attendance, fees and WhatsApp updates for tuition centres, coaching classes and academies in India.',
  installUrl: [PLAY_STORE_URL, APP_STORE_URL],
  offers: PLANS.map((p) => ({ '@type': 'Offer', name: p.name, price: p.month, priceCurrency: 'INR' })),
  publisher: { '@type': 'Organization', name: 'M2W Technologies Private Limited' },
};
---
<Base
  title="ChalkPis Tutor: Fee management for tuition centres"
  description="Collect fees on time with WhatsApp reminders and your own UPI QR. Take attendance in seconds and keep parents updated, all from one app. Free for 7 days."
  schema={schema}
>
  <!-- hero -->
  <section class="wrap hero">
    <div class="hero-copy">
      <a href="#features" class="chip"><span class="chip-new">New</span>Parents can confirm payment from the fee reminder</a>
      <h1 class="h1 hero-h1">Collect every fee <span class="hl">on time</span></h1>
      <p class="lead hero-lead">ChalkPis Tutor sends fee reminders on WhatsApp with your UPI QR, records attendance in seconds and issues receipts automatically, so you can focus on teaching.</p>
      <div class="hero-cta">
        <a class="btn btn-dark" href={START_URL}>Start 7-day free trial<Icon name="arrow" size={18} /></a>
        <button type="button" class="btn btn-soft" data-demo>Book a demo</button>
      </div>
    </div>
    <div class="hero-shot">
      <img src="/app/home-dashboard.webp" width="480" height="640" fetchpriority="high" alt="The ChalkPis Tutor Home screen: fees collected this month, pending and overdue fees, and today's attendance" />
    </div>
  </section>

  <!-- cities -->
  <section style="padding-top: 64px" aria-label="Where tutors use ChalkPis Tutor">
    <p class="small" style="text-align: center; padding: 0 24px">Used by tuition centres and academies in</p>
    <div class="marquee wrap" style="margin-top: 18px">
      <ul class="marquee-track">
        {cityLoop.map((c) => <li class="city" aria-hidden={c.copy ? 'true' : undefined}>{c.name}</li>)}
      </ul>
    </div>
  </section>

  <!-- why tutors switch: plain facts, no invented numbers -->
  <WhyBand />

  <!-- the problems, each answered with the screen that solves it -->
  <section id="features" class="sec">
    <div class="wrap qa-list">
      <QaRow q="Fee reminders that send themselves" a="Reminders go out on WhatsApp with your UPI QR, so parents can pay in a tap. See who has paid at a glance.">
        <div class="panel qa-panel">
          <div class="visual-head"><span class="h4">November 2026</span><span class="small">54 of 64 paid</span></div>
          <div class="bar"><div style="width: 84%"></div></div>
          <div style="margin-top: 10px">
            <div class="row"><span style="flex: 1">Riya Shah</span><strong>₹1,500</strong><span class="btn btn-xs btn-soft">Remind</span></div>
            <div class="row"><span style="flex: 1; min-width: 0">Kabir Mehta<span class="small" style="display: block; font-size: 12px">Paid ₹800 of ₹1,500</span></span><strong>₹700</strong><span class="btn btn-xs btn-soft">Remind</span></div>
            <div class="row" style="padding-bottom: 0"><span style="flex: 1">Diya Sen</span><strong>₹1,200</strong><span class="btn btn-xs btn-soft">Remind</span></div>
          </div>
        </div>
      </QaRow>
      <QaRow flip q="Know exactly who has paid" a="Parents tap “I've paid” on the reminder. You confirm in one tap, and the receipt is sent on WhatsApp.">
        <div class="panel qa-panel">
          <p class="small" style="font-size: 12px">Riya Shah's parent says</p>
          <p class="num" style="margin-top: 4px; font-size: 26px">₹1,500 paid by UPI</p>
          <p class="small" style="font-size: 12px; margin-top: 2px">Ref 4521 · 9:41 am</p>
          <div style="margin-top: 20px; display: flex; gap: 8px"><span class="btn btn-sm btn-dark" style="flex: 1">Confirm</span><span class="btn btn-sm btn-soft" style="flex: 1">Not received</span></div>
        </div>
      </QaRow>
      <QaRow q="Parents informed the same day" a="When you save attendance, parents of absent students get a WhatsApp alert. These are the messages the app sends, word for word.">
        <div class="chat">
          <span class="chat-day">Today</span>
          <div class="bubble">Hello, Riya Shah was marked <strong>absent</strong> for the Class 9 Science class on 4 Nov 2026. If this is not correct, please contact Sharma Tuitions directly. Thank you.<span class="time">4:12 pm</span></div>
          <div class="bubble">Hello, we have received the fee payment for Riya Shah: ₹1,500 (receipt 0142, balance due ₹0). Please keep this message as your receipt. Regards, Sharma Tuitions. Thank you.<span class="time">6:40 pm</span></div>
        </div>
      </QaRow>
      <QaRow flip q="Attendance in seconds" a="Mark only the absentees and save. Late arrivals, holidays and the monthly register are kept for you.">
        <div class="panel qa-panel">
          <div class="visual-head"><span class="h4">Class 9 Science</span><span class="small">Today, 4:00 pm</span></div>
          <div style="margin-top: 14px">
            <div class="row"><span>Ananya Rao</span><span class="pill ok">Present</span></div>
            <div class="row"><span>Riya Shah</span><span class="pill no">Absent</span></div>
            <div class="row"><span>Sai Kumar</span><span class="pill due">Late</span></div>
          </div>
          <div style="margin-top: 12px; display: flex; gap: 8px"><span class="btn btn-sm btn-dark" style="flex: 1">Save attendance</span><span class="btn btn-sm btn-soft">Holiday</span></div>
        </div>
      </QaRow>
    </div>
  </section>

  <!-- more in the app: pick a feature, see its screen -->
  <section id="more" class="sec">
    <div class="wrap">
      <div class="head"><h2 class="h2">Everything else your centre needs</h2></div>
      <div class="card switcher" data-switcher>
        <div class="sw-list" role="tablist" aria-label="More in the app">
          {MORE.map((m, i) => (
            <button class="sw-tab" type="button" role="tab" id={`sw-${m.id}`} aria-controls={`swp-${m.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
              <span class="tile tile-sm"><Icon name={m.icon} size={17} /></span>
              <span><span class="sw-title">{m.title}</span><span class="sw-desc">{m.desc}</span></span>
            </button>
          ))}
        </div>
        <div class="sw-art">
          <div class="panel sw-panel" role="tabpanel" id="swp-tests" aria-labelledby="sw-tests">
            <p style="font-size: 14px; font-weight: 600">Unit test 3 · Maths · out of 50</p>
            <div style="margin-top: 8px">
              <div class="row rank"><span class="r">1</span><span style="flex: 1">Ananya Rao</span><span>48</span><span class="g">A1</span></div>
              <div class="row rank"><span class="r">2</span><span style="flex: 1">Ishaan Reddy</span><span>45</span><span class="g">A1</span></div>
              <div class="row rank"><span class="r">3</span><span style="flex: 1">Meera Pillai</span><span>41</span><span class="g" style="color: var(--blue-ink)">A2</span></div>
              <div class="row rank"><span class="r">4</span><span style="flex: 1">Sai Kumar</span><span>37</span><span class="g" style="color: var(--blue-ink)">B1</span></div>
            </div>
          </div>
          <div class="panel sw-panel" role="tabpanel" id="swp-parts" aria-labelledby="sw-parts" hidden>
            <p style="font-size: 14px; font-weight: 600">Yearly fee 2026-27 · ₹18,000 in 3 parts</p>
            <div style="margin-top: 8px">
              <div class="row tight"><span>Part 1 · ₹6,000</span><span class="pill ok">Paid</span></div>
              <div class="row tight"><span>Part 2 · ₹6,000</span><span class="pill due">Due 10 Dec</span></div>
              <div class="row tight"><span>Part 3 · ₹6,000</span><span class="pill mute">10 Mar</span></div>
            </div>
          </div>
          <div class="panel sw-panel" role="tabpanel" id="swp-enquiries" aria-labelledby="sw-enquiries" hidden>
            <div style="display: flex; flex-wrap: wrap; gap: 6px"><span class="pill mute">New</span><span class="pill mute">Follow-up</span><span class="pill" style="background: var(--blue-50); color: var(--blue-ink)">Trial class</span><span class="pill mute">Joined</span></div>
            <div style="margin-top: 14px; border-radius: 12px; background: var(--surface); padding: 12px"><p style="font-size: 14px; font-weight: 600">Kabir · Class 7 Maths</p><p class="small" style="font-size: 12px; margin-top: 2px">Trial class on Saturday · walk-in</p></div>
            <p style="margin-top: 14px; font-size: 14px; color: var(--blue-ink); font-weight: 600">3 parents to follow up today</p>
          </div>
          <div class="panel sw-panel week" role="tabpanel" id="swp-timetable" aria-labelledby="sw-timetable" hidden>
            {['Mon', 'Tue', 'Wed', 'Thu', 'Fri'].map((d) => <span class="day">{d}</span>)}
            {['b', '', 'b', '', 'b', '', 'b', 'clash', 'b', '', 'b', '', 'hol', '', 'b'].map((c) => <span class={`slot ${c}`}></span>)}
          </div>
          <div class="sw-panel poster" role="tabpanel" id="swp-posters" aria-labelledby="sw-posters" hidden>
            <p style="font-size: 12px; font-weight: 600; color: #8ec5ea">Nritya Dance Academy</p>
            <p class="num" style="margin-top: 6px; font-size: 28px; color: var(--yellow)">Our dance stars</p>
            <p style="margin-top: 4px; font-size: 13px; color: #d4d4d8">Congratulations on a wonderful performance!</p>
            <div style="margin-top: auto; display: flex; gap: 10px"><span class="star"></span><span class="star"></span><span class="star"></span></div>
          </div>
        </div>
      </div>
      <p class="body" style="margin: 40px auto 0; max-width: 680px; text-align: center">Also in the app: homework, one parent link for brothers and sisters, advance payments, importing students from Excel, reports to Excel and PDF, a private page for each child, and a bigger screen for your laptop. <a href="/features" class="link-blue">See every feature</a></p>
    </div>
  </section>

  <!-- statement + laptop dashboard -->
  <section class="sec">
    <div class="wrap">
      <div class="stmt">
        <h2 class="h2" style="max-width: 720px; margin: 0 auto">Less paperwork. More time to teach.</h2>
        <div class="laptop" role="img" aria-label="The ChalkPis Tutor dashboard on a laptop">
          <div class="side hide-sm">
            <Logo height={26} />
            <p style="margin: 18px 0 6px; font-size: 12px; font-weight: 600; color: var(--faint)">Your classes</p>
            <span class="side-item on">Home</span><span class="side-item">Students</span><span class="side-item">Attendance</span><span class="side-item">Fees</span><span class="side-item">Reports</span>
          </div>
          <div class="dash">
            <p class="num" style="font-size: 20px">Good evening, Priya</p>
            <div class="stats">
              <div class="panel stat"><p class="small" style="font-size: 12px">Students</p><p class="num">64</p></div>
              <div class="panel stat"><p class="small" style="font-size: 12px">Pending</p><p class="num">₹8,200</p></div>
              <div class="stat stat-blue"><p style="font-size: 12px; opacity: 0.85">Collected this month</p><p class="num">₹42,500</p></div>
            </div>
            <div class="panel" style="margin-top: 10px; padding: 14px">
              <p style="font-size: 12px; font-weight: 600">Attendance this week</p>
              <div class="bars">{[82, 90, 76, 94, 88, 60].map((h, i) => <span style={`height: ${h}%`} class={i === 4 ? 'now' : i === 5 ? 'later' : ''}></span>)}</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- roles -->
  <section id="roles" class="sec">
    <div class="wrap">
      <div class="head"><h2 class="h2">Built for your whole centre</h2></div>
      <div class="roles" data-roles>
        <div role="tablist" aria-label="Who uses ChalkPis Tutor" class="role-tabs">
          {ROLES.map((r, i) => (
            <button class="role-tab" type="button" role="tab" id={`tab-${r.id}`} aria-controls={`panel-${r.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
              <span class="role-title">{r.title}</span>
              <span class="role-desc">{r.desc}</span>
            </button>
          ))}
        </div>
        {ROLES.map((r, i) => (
          <div class="card role-panel" role="tabpanel" id={`panel-${r.id}`} aria-labelledby={`tab-${r.id}`} hidden={i !== 0}>
            {r.steps.map((s, j) => (
              <>
                {j > 0 && <span class="step-line" aria-hidden="true"></span>}
                <div class={`panel step ${j === r.steps.length - 1 ? 'last' : ''}`}>
                  <span class="tile" style="width: 40px; height: 40px; border-radius: 12px"><Icon name={s.icon} size={18} /></span>
                  <span style="flex: 1; min-width: 0; font-size: 15px; font-weight: 600; line-height: 1.3">{s.title}<span class="step-sub">{s.sub}</span></span>
                </div>
              </>
            ))}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- testimonials -->
  <section class="sec" aria-labelledby="say">
    <div class="wrap"><div class="head"><h2 class="h2" id="say">What teachers say</h2></div></div>
    {scrollQuotes ? (
      <div class="marquee" style="margin-top: 48px">
        <div class="marquee-track qtrack">
          {quoteLoop.map((q) => (
            <figure class="card quote" aria-hidden={q.copy ? 'true' : undefined}>
              <p class="h4">{q.title}</p>
              <blockquote class="body" style="color: var(--text)">{q.text}</blockquote>
              <figcaption><span class="tile" style="width: 36px; height: 36px; border-radius: 50%"><Icon name="user" size={16} /></span><span><strong style="display: block; color: var(--ink); font-weight: 600">{q.who}</strong>{q.where}</span></figcaption>
            </figure>
          ))}
        </div>
      </div>
    ) : (
      <div class="wrap featured">
        {QUOTES.map((q) => (
          <figure class="card featured-quote">
            <svg class="quote-mark" width="40" height="32" viewBox="0 0 40 32" aria-hidden="true"><path fill="currentColor" d="M0 32V19.2C0 8.6 5.9 2.2 16.4 0l1.8 4.2C12.6 6 9.8 9.6 9.4 14.4H17V32H0Zm22.6 0V19.2C22.6 8.6 28.5 2.2 39 0l1 4.2c-5.6 1.8-8.4 5.4-8.8 10.2h7.6V32H22.6Z" /></svg>
            <p class="h3" style="margin-top: 20px">{q.title}</p>
            <blockquote class="lead" style="margin-top: 14px; color: var(--text)">{q.text}</blockquote>
            <figcaption class="featured-who">
              <span class="tile" style="width: 44px; height: 44px; border-radius: 50%"><Icon name="user" size={20} /></span>
              <span><strong style="display: block; font-weight: 600; color: var(--ink)">{q.who}</strong><span class="small">{q.where} · uses ChalkPis Tutor</span></span>
            </figcaption>
          </figure>
        ))}
      </div>
    )}
  </section>

  <!-- pricing: the same plan picker as /pricing -->
  <section id="pricing" class="sec">
    <div class="wrap">
      <div class="head">
        <h2 class="h2">Simple pricing based on your students</h2>
        <p class="body" style="margin-top: 14px">Every plan includes every feature. Try it free for {TRIAL_DAYS} days.</p>
      </div>
      <PlanCards />
    </div>
  </section>

  <!-- day-to-day questions (the plan and billing ones are on /pricing) -->
  <section id="faq" class="sec">
    <div class="wrap">
      <FaqColumns title="Frequently asked questions" items={HOME_FAQS}>
        <p class="body" style="margin-top: 14px">Questions about plans and billing are on the <a href="/pricing#faq">pricing page</a>.</p>
      </FaqColumns>
    </div>
  </section>

  <!-- closing band -->
  <section class="sec end">
    <div class="wrap"><CtaBand title="Ready to collect fees on time?" from="home_band" /></div>
  </section>
</Base>

<script>
  // Role tabs: click or arrow keys switch the panel (WAI-ARIA tabs pattern).
  document.querySelectorAll<HTMLElement>('[data-roles]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const select = (tab: HTMLButtonElement) => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute('aria-selected', on ? 'true' : 'false');
        t.tabIndex = on ? 0 : -1;
        const panel = root.querySelector<HTMLElement>(`#${t.getAttribute('aria-controls')}`);
        if (panel) panel.hidden = !on;
      });
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(t));
      t.addEventListener('keydown', (e) => {
        const step = e.key === 'ArrowDown' || e.key === 'ArrowRight' ? 1 : e.key === 'ArrowUp' || e.key === 'ArrowLeft' ? -1 : 0;
        if (!step) return;
        e.preventDefault();
        const next = tabs[(i + step + tabs.length) % tabs.length];
        select(next);
        next.focus();
      });
    });
  });

  // "More in the app": the same tabs pattern. It moves on by itself every 5 s until someone picks a feature, and
  // never when the visitor prefers reduced motion or the section is off screen.
  document.querySelectorAll<HTMLElement>('[data-switcher]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    let current = 0;
    let timer: number | undefined;
    const select = (i: number, focus = false) => {
      current = (i + tabs.length) % tabs.length;
      tabs.forEach((t, j) => {
        const on = j === current;
        t.setAttribute('aria-selected', on ? 'true' : 'false');
        t.tabIndex = on ? 0 : -1;
        const panel = root.querySelector<HTMLElement>(`#${t.getAttribute('aria-controls')}`);
        if (panel) panel.hidden = !on;
      });
      if (focus) tabs[current].focus();
    };
    const stop = () => window.clearInterval(timer);
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => { stop(); select(i); });
      t.addEventListener('keydown', (e) => {
        const step = e.key === 'ArrowDown' || e.key === 'ArrowRight' ? 1 : e.key === 'ArrowUp' || e.key === 'ArrowLeft' ? -1 : 0;
        if (!step) return;
        e.preventDefault();
        stop();
        select(i + step, true);
      });
    });
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      new IntersectionObserver(([entry]) => {
        stop();
        if (entry.isIntersecting) timer = window.setInterval(() => select(current + 1), 5000);
      }).observe(root);
      root.addEventListener('pointerenter', stop);
    }
  });
</script>

<style>
  /* hero: the question on the left, the real app's Home screen on the right */
