---
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/inter/800.css';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import CookieBanner from '../components/CookieBanner.astro';
import DemoDialog from '../components/DemoDialog.astro';
import GetAppCard from '../components/GetAppCard.astro';
import MobileCta from '../components/MobileCta.astro';
import { createHash } from 'node:crypto';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import {
  SITE_NAME, SITE_URL, COMPANY, SUPPORT_EMAIL, SUPPORT_WHATSAPP, PLAY_STORE_URL, APP_STORE_URL,
} from '../config';

interface Props {
  title: string;
  description: string;
  /** Extra JSON-LD for this page. */
  schema?: Record<string, unknown>;
  /** Keep the page out of search results (and out of the sitemap, see astro.config.mjs). */
  noindex?: boolean;
}
const { title, description, schema, noindex } = Astro.props;
// build.format 'file' makes Astro.url end in .html (/index.html, /pricing.html), but the site is served and listed in the
// sitemap without it (/, /pricing), so the canonical address drops it.
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/(^|\/)index$/, '/') || '/';
const canonical = new URL(path, SITE_URL).href;
// Facebook (and Cloudflare) keep their own copy of a share image per URL, so the URL carries a hash of the file:
// a new og.png gets a new URL by itself and is fetched fresh. One share image for every page (the user's choice).
const ogHash = createHash('sha1').update(readFileSync(join(process.cwd(), 'public', 'og.png'))).digest('hex').slice(0, 10);
const ogImage = new URL(`/og.png?v=${ogHash}`, SITE_URL).href;

// One JSON-LD graph per page: who makes ChalkPis Tutor and the site itself on every page (so search engines and AI
// answer engines tie every page to the same company), then the page's own nodes (FAQ, breadcrumbs, app...).
const ORG_ID = `${SITE_URL}/#org`;
const siteNodes = [
  {
    '@type': 'Organization',
    '@id': ORG_ID,
    name: COMPANY,
    alternateName: ['Man2Web', SITE_NAME],
    url: `${SITE_URL}/`,
    logo: { '@type': 'ImageObject', url: `${SITE_URL}/apple-touch-icon.png`, width: 180, height: 180 },
    email: SUPPORT_EMAIL,
    contactPoint: {
      '@type': 'ContactPoint',
      contactType: 'customer support',
      telephone: `+${SUPPORT_WHATSAPP}`,
      email: SUPPORT_EMAIL,
      areaServed: 'IN',
      availableLanguage: ['English', 'Hindi', 'Tamil'],
    },
    areaServed: 'IN',
    sameAs: [PLAY_STORE_URL, APP_STORE_URL],
  },
  {
    '@type': 'WebSite',
    '@id': `${SITE_URL}/#website`,
    name: SITE_NAME,
    url: `${SITE_URL}/`,
    inLanguage: 'en-IN',
    publisher: { '@id': ORG_ID },
  },
];
const pageNodes = !schema ? [] : Array.isArray(schema['@graph']) ? (schema['@graph'] as unknown[]) : [schema];
const graph = {
  '@context': 'https://schema.org',
  '@graph': [...(noindex ? [] : siteNodes), ...pageNodes.map((n) => {
    const { '@context': _ctx, ...rest } = n as Record<string, unknown>;
    return rest;
  })],
};
---
<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#ffffff" />
    <!-- Bing Webmaster Tools site verification -->
    <meta name="msvalidate.01" content="70F9C3A4E18C62197FA0A6A4DC0F2F48" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="ChalkPis Tutor: collect every fee on time. The app's Home screen with fees collected and pending." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    {graph['@graph'].length > 0 && <script type="application/ld+json" set:html={JSON.stringify(graph)} />}
    <link rel="alternate" type="text/plain" href="/llms.txt" title="ChalkPis Tutor for AI assistants" />
    <Analytics />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Nav />
    <main id="main"><slot /></main>
    <Footer />
    <DemoDialog />
    {!noindex && <GetAppCard />}
    {!noindex && <MobileCta />}
    <CookieBanner />
    <ScrollReveal />
  </body>
</html>
