# Copy to functions/.env (git-ignored) and fill in. Not secrets: the WhatsApp login lives in Firebase secrets.
# Leave a value as `unset` until you have it; the app then logs messages as "not set up yet" instead of sending.

# The WhatsApp gateway's send URL (ask your provider for the hostname; do not use a bare IP over https).
WA_API_URL=unset
# Your WhatsApp business number, digits only with country code, e.g. 916384009225
WA_FROM=unset
# POST works for most gateways. Change to GET only if your provider insists.
WA_API_METHOD=POST
# Approved template ids, one line of JSON (see docs/WHATSAPP-TEMPLATES.md):
# WA_TEMPLATES={"absent":{"en":"123","hi":"124"},"late":{"en":"125"},"fee_due":{"en":"126"},"fee_overdue":{"en":"127"},"payment_received":{"en":"128"}}
WA_TEMPLATES={}
