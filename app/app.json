{
  "expo": {
    "name": "Chalkpis for Tutors",
    "slug": "chalkpis",
    "scheme": "chalkpis",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "android": {
      "package": "in.chalkpis.tutors",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "READ_CONTACTS",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ]
    },
    "plugins": [
      "expo-dev-client",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableMinifyInReleaseBuilds": true
          }
        }
      ],
      "expo-localization",
      "expo-sharing",
      "expo-secure-store",
      "expo-contacts",
      "expo-asset",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/splash-blank.png",
          "imageWidth": 104
        }
      ],
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "2912efb6-e322-43b4-818d-41bdf9d09534"
      }
    },
    "owner": "man2web",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/2912efb6-e322-43b4-818d-41bdf9d09534",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "bundleIdentifier": "in.chalkpis.tutors",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSContactsUsageDescription": "Chalkpis reads a contact only when you choose to add a student or parent from your contacts.",
        "NSPhotoLibraryUsageDescription": "Chalkpis uses a photo you pick as your institute logo or a student photo.",
        "NSCameraUsageDescription": "Chalkpis uses the camera when you take a photo for your institute logo or a student."
      }
    }
  }
}
