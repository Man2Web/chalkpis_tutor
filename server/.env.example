# Copy to server/.env for local runs. In Coolify, set these as the app's environment variables instead.
NODE_ENV=development
PORT=8787
LOG_LEVEL=info
# Set to true in production: Coolify's proxy sits in front, so the real visitor address comes from X-Forwarded-For.
TRUST_PROXY=false

# Local test database from `npm run db:start` (port 3307). In production use the Coolify database's values.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=tutordesk
DB_PASSWORD=tutordesk-local
DB_NAME=tutordesk
DB_POOL_SIZE=10
DB_SSL=false
AUTO_MIGRATE=true

# Signing secrets: generate each with `openssl rand -base64 48` (never reuse, never commit the real ones).
JWT_SECRET=local-only-jwt-secret-please-replace-with-48-random-chars
OTP_PEPPER=local-only-otp-pepper-please-replace-with-48-random-chars
ACCESS_TTL_MINUTES=15
REFRESH_TTL_DAYS=60
# Development only: also return the login code in the response (ignored in production).
OTP_DEV_ECHO=true

# WhatsApp gateway for login codes. Leave unset locally (a mock sender is used).
# WA_API_URL=https://103.229.250.150/unified/v2/send   (its certificate is valid for this address until 1 Dec 2026)
# WA_FROM=916384009225
# WA_CLIENT_ID=            (set in Coolify, never in this file)
# WA_CLIENT_PASSWORD=      (set in Coolify, never in this file)
# WA_API_METHOD=POST
# Or send through Meta's WhatsApp Cloud API directly (takes priority over ValueFirst when both are set):
# WA_CLOUD_PHONE_NUMBER_ID=   (WhatsApp Manager > Phone numbers > the number > Phone number ID)
# WA_CLOUD_TOKEN=             (system user token; set in Coolify, never in this file)
# Approved authentication template id for the login code. Gateway id and Meta id are different numbers: use the one your gateway expects.
WA_TEMPLATE_OTP=1809804

# Public address of this server (used for parent links and logo addresses). Must be https in production.
# PUBLIC_BASE_URL=https://tutor.chalkpis.com
# Where uploaded logos and student photos are stored. In the container this is the mounted volume /data/uploads.
# FILES_DIR=data/files
# Requests per minute from one address (login and upload routes have their own, stricter limits).
RATE_LIMIT_PER_MIN=300
# Length of the free trial for new institutes, in days (default 7).
# TRIAL_DAYS=7

# Every message type (parent and centre messages), as JSON: template ids from wa.adsme.in (or names through Meta).
# Templates and their texts: docs/WHATSAPP-TEMPLATES.md.
WA_TEMPLATES={"absent":{"en":"cp_absent_alert"},"late":{"en":"cp_late_alert"},"fee_due":{"en":"cp_fee_due_soon"},"fee_overdue":{"en":"cp_fee_overdue"},"payment_received":{"en":"cp_payment_receipt"},"fee_reminder":{"en":"cp_fee_qr"},"fee_link":{"en":"cp_fee_link"},"parent_link":{"en":"cp_parent_page"},"student_welcome":{"en":"cp_student_welcome"},"class_cancelled":{"en":"cp_class_cancelled"},"centre_welcome":{"en":"cp_centre_welcome"},"trial_ending":{"en":"cp_trial_ending"},"plan_active":{"en":"cp_plan_active"},"helper_invite":{"en":"cp_helper_invite"}}

# Mobile numbers that may open the admin dashboard at /admin (comma separated)
# ADMIN_PHONES=9876543210

# PhonePe Payment Gateway (plan purchases), from PhonePe Business > Developer settings > API keys.
# PHONEPE_CLIENT_ID=
# PHONEPE_CLIENT_SECRET=
# PHONEPE_CLIENT_VERSION=1
# PHONEPE_ENV=sandbox          # production with live keys
# PHONEPE_WEBHOOK_USERNAME=     # the pair you set on the webhook in the PhonePe dashboard
# PHONEPE_WEBHOOK_PASSWORD=

# Admin dashboard emails: sign-in codes, password resets, lockout alerts (see docs/SETUP.md 4b).
# SMTP_HOST=smtp.zoho.in
# SMTP_PORT=465
# SMTP_USER=hello@chalkpis.com
# SMTP_PASS=
# MAIL_FROM=Chalkpis <hello@chalkpis.com>

# App Store / Play review login: this number signs in with this 6-digit code, no WhatsApp message is sent.
# Set only while a store review runs, then remove. Give both to the reviewers in the store consoles.
# REVIEW_PHONE=
# REVIEW_CODE=

# Admin dashboard sign-in: these emails only (comma-separated). Each signs in with email + password + a code
# emailed at every sign-in; set the password the first time with "Forgot password" on /admin. Needs SMTP.
# ADMIN_EMAILS=hello@man2web.com
